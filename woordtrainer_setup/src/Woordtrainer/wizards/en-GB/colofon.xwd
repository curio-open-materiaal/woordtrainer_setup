<wizard menus="Woordtrainer">
  <pageWizard remove="true" duplicate="false">
    <newNodes>
      <colofon><![CDATA[
        <colofon name="colofon" leftText="" rightText=""
        />
      ]]></colofon>
    </newNodes>
  </pageWizard>

  <colofon
    menu="Woordtrainer"
    menuItem="colofon"
    hint="Colofon"
    icon="icLayers"
    thumb="thumbs/hotspotImage.jpg"
    remove="true">

    <name label="Paginatitel" type="TextInput" wysiwyg="true"/>
    <leftText label="Linker kolom" type="TextArea" height="250" wysiwyg="true" placeholder="Laat leeg voor standaardtekst (alleen als beide kolommen leeg zijn)"/>
    <rightText label="Rechter kolom" type="TextArea" height="250" wysiwyg="true" placeholder="Laat leeg voor standaardtekst (alleen als beide kolommen leeg zijn)"/>

  </colofon>
</wizard>
